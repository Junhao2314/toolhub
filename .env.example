TOOLHUB_PORT=18480
TOOLHUB_DATABASE_URL=postgres://toolhub:change-me@postgres:5432/toolhub?sslmode=disable
TOOLHUB_MASTER_KEY=replace-with-32-byte-base64-key
TOOLHUB_BOOTSTRAP_USERNAME=admin
TOOLHUB_BOOTSTRAP_PASSWORD=replace-with-a-long-password
TOOLHUB_LOCAL_NODE_NAME=project-host
TOOLHUB_MANAGED_USERNAME=your-linux-user
TOOLHUB_BRIDGE_RUN_DIR=/run/toolhub-bridge
TOOLHUB_BRIDGE_GID=replace-with-toolhub-group-gid
TOOLHUB_BRIDGE_HMAC_KEY=replace-with-the-value-from-/etc/toolhub-bridge/hmac.key
TOOLHUB_RELAY_PORT=6276
TOOLHUB_TIMEZONE=Asia/Shanghai
SKILLSMP_API_KEY=
# Optional: Xiaping (虾评) marketplace source. Search works without a key;
# the key unlocks explicit Xiaping imports (official skills may charge the account's coins).
XIAPING_API_KEY=
XIAPING_BASE_URL=https://xiaping.coze.com
# SkillHub (技能广场) marketplace source. Public API, no key required.
# Default: https://api.skillhub.tencent.com
SKILLHUB_BASE_URL=
