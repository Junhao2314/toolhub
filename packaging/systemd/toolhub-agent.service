[Unit]
Description=ToolHub Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/toolhub-agent run --config /etc/toolhub-agent/agent.json
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/var/lib/toolhub-agent
ReadWritePaths=-%h

[Install]
WantedBy=multi-user.target
